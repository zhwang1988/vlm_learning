# =============================================================================
# .env.example —— 复制成 .env 后填自己的值
#
#   cp .env.example .env
#
# .env 已经在 .gitignore 里，不会被提交。
# 任何时候不要把真实密钥写进代码或 notebook。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 模型 API（Day 1–Day 12 主要靠它，不需要 GPU）
# -----------------------------------------------------------------------------
# 数据合成要调很多次，选一个便宜的。
# 选项：
#   dashscope  —— 阿里云百炼（Qwen 官方，国内直连，推荐）
#   openai     —— OpenAI 兼容的任何服务（含 vLLM 本地服务）
#   siliconflow—— 硅基流动（便宜，含 Qwen-VL）
API_PROVIDER=dashscope
SYNTH_MODEL=qwen-vl-plus
SYNTH_API_KEY=
SYNTH_BASE_URL=
# 合成 5000 条大约的花费：qwen-vl-plus 量级在几十元。先用 --limit 20 试跑。

# 评测时当裁判用的模型。建议换一个不同的模型，避免「自己评自己」。
# 注意：裁判模型必须比被测模型强，否则校准会达不到 0.7。
JUDGE_MODEL=qwen-max
JUDGE_API_KEY=
JUDGE_BASE_URL=

# -----------------------------------------------------------------------------
# 2. 云 GPU 环境（Day 14 起）
# -----------------------------------------------------------------------------
# 本地开发时，模型服务指向云上的 vLLM
VLLM_BASE=http://localhost:8000/v1
SERVED_MODEL=cx-vlm
REQUEST_TIMEOUT=30
MAX_CONCURRENCY=16
# 图片长边上限。调小它是省显存最有效的手段（见 docs/04-qwen25vl.md）
MAX_PIXELS_RATIO=1280

# Agent 用的模型（可以是本地 vLLM，也可以是远端 API）
AGENT_MODEL=cx-vlm

# 数据盘（云实例上一般自动探测 /root/autodl-tmp）
# MMLAB_DATA_ROOT=/root/autodl-tmp
HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=/root/autodl-tmp/hf-cache

# -----------------------------------------------------------------------------
# 3. Shopify App（Day 39 起）
# -----------------------------------------------------------------------------
# 从 https://partners.shopify.com 建 app 后拿到
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.example.com
SHOPIFY_API_VERSION=2025-01
# 权限最小化原则：只加真的用到的，多一个都是审核负担和客户顾虑
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_customers,read_fulfillments,write_fulfillments,read_inventory

# 本地开发用 Shopify CLI 的 tunnel，上线换成正式域名
SHOPIFY_TUNNEL_URL=

# -----------------------------------------------------------------------------
# 4. 数据库（Shopify App 需要）
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://mmlab:mmlab@localhost:5432/mmlab
# pgvector 用于商品图检索（Day 35）。用官方镜像 pgvector/pgvector:pg16 自带。
PGVECTOR_ENABLED=true

# 可选：额度控制（Day 42 防刷爆成本）
DAILY_TOKEN_LIMIT_PER_SHOP=200000

# -----------------------------------------------------------------------------
# 5. 日志与调试
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# 打开后会打印完整 prompt（含图片 token 占位符），调试用，生产关掉
DEBUG_PROMPT=false
# PII 脱敏开关，生产必须 true（订单号/手机号/邮箱）
PII_REDACTION=true
